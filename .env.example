# Local Docker Mongo service name example:
# MONGODB_URI=mongodb://mongo:27017/diploma-platform
# Local standalone Mongo example:
# MONGODB_URI=mongodb://127.0.0.1:27017/diploma-platform
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/diploma-platform
MONGODB_URI=mongodb://127.0.0.1:27017/diploma-platform

JWT_SECRET=replace_with_strong_secret
PYTHON_RECOMMENDER_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
